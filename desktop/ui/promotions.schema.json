{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cinema Movie Finder promotion",
  "description": "Jeden obiekt z desktop/ui/promotions.json. Dodanie obiektu nie wymaga zmiany JavaScriptu.",
  "type": "object",
  "required": ["id", "chain", "title", "price", "state", "facts", "note", "networks", "links"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "featured": { "type": "boolean" },
    "chain": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "price": { "type": "string", "minLength": 1 },
    "state": { "type": "string", "minLength": 1 },
    "facts": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "note": { "type": "string" },
    "networks": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "prefixItems": [{ "type": "string" }, { "type": "string", "format": "uri" }],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "start": { "type": "string", "format": "date" },
    "end": { "type": "string", "format": "date" },
    "kind": { "type": "string", "enum": ["general", "weekday", "wednesday", "advance", "online"] },
    "weekday": { "type": "integer", "minimum": 0, "maximum": 6 },
    "trackable": { "type": "boolean" },
    "savings": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } } },
    "verification": {
      "description": "Opcjonalne reguły AND sprawdzane w tekście oficjalnych stron.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern"],
        "properties": {
          "pattern": { "type": "string" },
          "flags": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
